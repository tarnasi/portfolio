  <rms:rms_experience_0_description>Engineered robust end-to-end functionalities using modern frameworks, integrating frontend and backend components to deliver seamless user experiences for diverse client applications.</rms:rms_experience_0_description>
  <rms:rms_experience_0_isCurrent>true</rms:rms_experience_0_isCurrent>
  <rms:rms_experience_0_location>Dubai, United Arab Emirates Â· On-site</rms:rms_experience_0_location>
